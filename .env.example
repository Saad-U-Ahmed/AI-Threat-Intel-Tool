# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# API auth (simple shared-secret header for internal tooling integration)
TI_API_KEY=change-me

# MITRE ATT&CK data source (STIX bundle). Leave default unless you mirror it internally.
ATTACK_STIX_URL=https://raw.githubusercontent.com/mitre/cti/master/enterprise-attack/enterprise-attack.json
ATTACK_CACHE_PATH=./data/enterprise-attack.json
ATTACK_CACHE_MAX_AGE_DAYS=7

# OSINT feeds gathering
REQUEST_TIMEOUT_SECONDS=15
MAX_ARTICLES_PER_RUN=8
